# RyTy environment configuration (Docker / local Node deployments).
# Copy this file to .env and fill in the values. Never commit .env to Git.

# ---- Required: initial administrator bootstrap (treated as a secret) ----
# Used exactly once: on first login when no administrator exists yet.
# You will be forced to change this password at first sign-in.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ---- Application defaults (optional; also configurable from Admin → Settings) ----
# IANA timezone used to group activities into days. Default: UTC.
APP_TIMEZONE=UTC
# Default UI language for new users: en | fa. Default: en.
DEFAULT_LANGUAGE=en

# ---- Server (optional) ----
# Host port exposed by Docker Compose. Default: 3000.
RYTY_PORT=3000
# Bind address of the Node server inside the container. Default: 0.0.0.0.
HOST=0.0.0.0
# SQLite database file location (inside the container). Default: /data/ryty.db.
DATA_PATH=/data/ryty.db
